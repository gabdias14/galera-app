# Sem estas variáveis o app roda 100% local (localStorage) — bom pra desenvolver.
# Com elas, usa o Supabase (dados reais, compartilhados entre aparelhos).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Domínio público usado nos links de convite (sem barra no fim).
# Em dev pode deixar vazio: o app usa a origem atual.
VITE_PUBLIC_URL=https://galera.app
